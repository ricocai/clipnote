// 根构建配置模板——复制为 build-profile.json5 后，在 DevEco Studio
// File > Project Structure > Signing Configs 里执行 "Automatically generate signing"
// （或手动填写 material 五项路径与密码）。build-profile.json5 已被 .gitignore
// 排除，真实凭据永不入库。
{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "<你的 .cer 证书绝对路径>",
          "keyAlias": "debugKey",
          "keyPassword": "",
          "profile": "<你的 .p7b 描述文件绝对路径>",
          "signAlg": "SHA256withECDSA",
          "storeFile": "<你的 .p12 密钥库绝对路径>",
          "storePassword": "",
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "targetSdkVersion": "26.0.0"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "common",
      "srcPath": "./common"
    },
    {
      "name": "speech",
      "srcPath": "./speech"
    },
    {
      "name": "mcp",
      "srcPath": "./mcp"
    }
  ]
}
