{
  "name": "clipnote-tools",
  "private": true,
  "version": "0.1.0",
  "description": "ClipNote 本机验证基线：领域内核单测 + 关键能力探测（G7）。不参与鸿蒙构建，产物在 dist/。",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --experimental-sqlite --test \"dist/tools/test/*.test.js\"",
    "probe:g7": "tsc -p tsconfig.json && node --experimental-sqlite dist/tools/probes/g7-search.js",
    "probe:g7-device": "tsc -p tsconfig.json && node dist/tools/probes/g7-search-device.js",
    "probe:g7-regression": "tsc -p tsconfig.json && node --experimental-sqlite dist/tools/probes/g7-regression.js",
    "probe:md-reader": "tsc -p tsconfig.json && node dist/tools/probes/md-reader-perf.js",
    "probe:g3": "tsc -p tsconfig.json && node dist/tools/probes/g3-interop.js",
    "drill:g5": "tsc -p tsconfig.json && node --experimental-sqlite dist/tools/probes/g5-restore-drill.js",
    "probe:g4": "tsc -p tsconfig.json && node dist/tools/probes/g4-readaloud-verify.js",
    "pretest": "node ./test/support/prepare-test.js",
    "test:keychain": "bash hypium-keychain.sh"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
