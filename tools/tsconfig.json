{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS + node 解析：允许无扩展名的相对导入（与 ArkTS 源码写法一致，避免内核为两套构建各写一遍）
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    // 关闭该 flag：ArkTS 无对应检查，保持内核源码为"两边都合法"的最低公共分母
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      // speech core 依赖 common 的 SpeechSegment（与 hvigor 构建一致的裸导入写法）；
      // 本机 node 构建经此映射解析到单文件（speech 目前只用到这一个符号）
      "common": ["common/src/main/ets/core/speech.ts"]
    }
  },
  "include": [
    "./test/**/*.ts",
    "./probes/**/*.ts",
    "../common/src/main/ets/core/**/*.ts",
    "../mcp/src/main/ets/core/**/*.ts",
    "../speech/src/main/ets/core/**/*.ts"
  ]
}
